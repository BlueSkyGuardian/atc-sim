# --- the public address (HTTPS is required: browsers only give the microphone to secure pages)
ATC_DOMAIN=atc.example.com
ATC_PUBLIC_URL=https://atc.example.com
# --- Google sign-in (OAuth client "Web application", see DEPLOY.md)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# --- these Gmail addresses are administrators (comma separated)
ATC_ADMIN_EMAILS=alaa.hamza@gmail.com
# --- never set ATC_DEV_LOGIN=1 here: it lets anyone sign in as any e-mail, without a password
# --- optional: a fixed secret for the session cookies (otherwise generated once into the data volume)
# ATC_SECRET_KEY=
# --- optional: an API key that scripts and agents send as the X-API-Key header (full rights)
# ATC_API_KEY=
# --- e-mail (invitations, shared scenarios, evaluations, new accounts): any SMTP server, e.g. Gmail with an
#     app password (smtp.gmail.com, 587, starttls), or your provider's SMTP relay. Without ATC_SMTP_HOST the
#     e-mails are only written to the data volume's outbox folder.
# ATC_SMTP_HOST=smtp.gmail.com
# ATC_SMTP_PORT=587
# ATC_SMTP_SECURITY=starttls
# ATC_SMTP_USER=atc.simulator@gmail.com
# ATC_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# ATC_SMTP_FROM=atc.simulator@gmail.com
# --- aviation news and the daily newsletter run by themselves (settings on the Users page); off on a machine
#     without internet:
# ATC_NEWS=off

# Live traffic (/live): a public ADS-B network, adsb.lol by default (no key today). A network that needs a key:
# ATC_LIVE_HEADERS=X-Api-Key: your-key
# ATC_LIVE=off
